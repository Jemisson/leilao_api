<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title><%= @product.lot_number %> |Leilões Virtuais</title>
  <% video_embed_url = @product.video_embed_url %>
  <% video_thumbnail_url = @product.video_thumbnail_url %>
  <% product_share_image_url =
       if @product.share_image
         share_image_url(@product)
       elsif video_thumbnail_url.present?
         video_thumbnail_url
       end
  %>

  <meta property="og:title" content="<%= @product.lot_number %>" />
  <meta property="og:description" content="<%= @product.description.truncate(100) %>" />
  <meta property="og:url" content="<%= share_url(@product) %>" />
  <meta property="og:type" content="<%= video_embed_url.present? ? 'video.other' : 'website' %>" />

  <% if product_share_image_url.present? %>
    <meta property="og:image" content="<%= product_share_image_url %>" />
    <meta property="og:image:secure_url" content="<%= product_share_image_url %>" />
    <meta property="og:image:type" content="image/jpeg" />
  <% end %>

  <% if video_embed_url.present? %>
    <meta property="og:video:url" content="<%= video_embed_url %>" />
    <meta property="og:video:secure_url" content="<%= video_embed_url %>" />
    <meta property="og:video:type" content="text/html" />
    <meta property="og:video:width" content="1280" />
    <meta property="og:video:height" content="720" />
  <% end %>

  <script>
    setTimeout(function() {
      window.location.href = "<%= product_url(@product) %>";
    }, 1000);
  </script>
</head>
<body>
  Redirecionando para o produto...
</body>
</html>
